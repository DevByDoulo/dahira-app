{
  "info": {
    "name": "Dahira App API",
    "description": "Collection complète pour tester l'API Dahira App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "dahira_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "membre_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', jsonData.data.token);",
                  "    console.log('Token saved:', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telephone\": \"221771234567\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telephone\": \"221771234567\",\n  \"password\": \"password123\",\n  \"nom\": \"Diallo\",\n  \"email\": \"test@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Dahiras",
      "item": [
        {
          "name": "Créer Dahira",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Dahira Test\",\n  \"adresse\": \"Dakar, Sénégal\",\n  \"telephone\": \"221771234567\",\n  \"email\": \"contact@dahira-test.sn\",\n  \"description\": \"Dahira de test pour l'API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/dahiras",
              "host": ["{{base_url}}"],
              "path": ["dahiras"]
            }
          }
        },
        {
          "name": "Liste Dahiras",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/dahiras?actif=true",
              "host": ["{{base_url}}"],
              "path": ["dahiras"],
              "query": [
                {
                  "key": "actif",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Détails Dahira",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/dahiras/{{dahira_id}}",
              "host": ["{{base_url}}"],
              "path": ["dahiras", "{{dahira_id}}"]
            }
          }
        }
      ]
    },
